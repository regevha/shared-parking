{
  "name": "shared-parking",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "antd": "^6.3.3",
    "dayjs": "^1.11.20",
    "i18next": "^23.16.8",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.18.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "eject": "react-scripts eject",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/recommended"
    ],
    "overrides": [
      {
        "files": [
          "src/**/__tests__/**",
          "src/**/*.test.ts",
          "src/**/*.test.tsx",
          "src/setupTests.ts"
        ],
        "rules": {
          "testing-library/no-wait-for-multiple-assertions": "off",
          "testing-library/prefer-find-by": "off",
          "testing-library/no-node-access": "off",
          "testing-library/no-unnecessary-act": "off",
          "testing-library/no-container": "off",
          "jest/no-conditional-expect": "off",
          "import/first": "off"
        }
      },
      {
        "files": [
          "src/api/__tests__/**"
        ],
        "rules": {
          "testing-library/no-await-sync-query": "off"
        }
      }
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@rc-component/.+/locale/.+$": "<rootDir>/src/__mocks__/emptyLocale.js",
      "^@rc-component/picker/generate/dayjs$": "<rootDir>/node_modules/@rc-component/picker/lib/generate/dayjs.js",
      "^@rc-component/picker/generate/(.+)$": "<rootDir>/node_modules/@rc-component/picker/lib/generate/$1.js",
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.59.1",
    "@types/jest-axe": "^3.5.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^9.0.0"
  }
}
