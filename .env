# Bind the dev server to all network interfaces so it's reachable from other
# devices on the same WiFi (phone, tablet, etc.).
HOST=0.0.0.0

# ── Backend Security (MVP Sprint) ─────────────────────────────────────────────
# SECRET_KEY: Change this in production! Use a long random string.
# Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=shared-parking-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Business Rules ────────────────────────────────────────────────────────────
CANCELLATION_WINDOW_HOURS=2
MAX_PENDING_REQUESTS=5
